<div>

  <%# Page header %>
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-900"><%= t("assets.index.title") %></h1>
      <p class="mt-1 text-sm text-slate-500"><%= t("assets.index.subtitle", count: @assets.count, default: "#{@assets.count} forms") %></p>
    </div>
    <%= link_to t("assets.index.new_button"), new_asset_path, class: "flex items-center gap-2 px-4 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white text-sm font-semibold shadow-sm transition" %>
  </div>

  <%# Flash notice %>
  <% if notice = flash[:notice] %>
    <div class="mb-6 flex items-center gap-3 rounded-lg bg-green-50 border border-green-200 px-4 py-3">
      <svg class="w-5 h-5 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
      </svg>
      <p class="text-sm font-medium text-green-700"><%= notice %></p>
    </div>
  <% end %>

  <% if @assets.any? %>

    <%# Desktop table %>
    <div class="hidden sm:block bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200">
            <th class="text-start px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide"><%= t("assets.table.date") %></th>
            <th class="text-start px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide"><%= t("assets.table.receiver") %></th>
            <th class="text-start px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide"><%= t("assets.table.employee_number") %></th>
            <th class="text-start px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide"><%= t("assets.table.branch_dept") %></th>
            <th class="text-start px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide"><%= t("assets.table.type") %></th>
            <th class="px-5 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @assets.each do |asset| %>
            <tr class="hover:bg-slate-50 transition group">
              <td class="px-5 py-4 text-slate-900 font-medium whitespace-nowrap">
                <%= asset.handover_date&.strftime("%d %b %Y") || "—" %>
              </td>
              <td class="px-5 py-4 text-slate-800"><%= asset.receiver_name %></td>
              <td class="px-5 py-4 text-slate-600"><%= asset.receiver_employee_number %></td>
              <td class="px-5 py-4 text-slate-600"><%= asset.receiver_branch_department %></td>
              <td class="px-5 py-4">
                <div class="flex flex-wrap gap-1.5">
                  <% if asset.is_consumable? %>
                    <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-700"><%= t("assets.badges.consumable") %></span>
                  <% end %>
                  <% if asset.is_custody? %>
                    <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-indigo-100 text-indigo-700"><%= t("assets.badges.custody") %></span>
                  <% end %>
                  <% unless asset.is_consumable? || asset.is_custody? %>
                    <span class="text-slate-400">—</span>
                  <% end %>
                </div>
              </td>
              <td class="px-5 py-4 text-end whitespace-nowrap">
                <div class="flex items-center justify-end gap-3">
                  <%= link_to t("assets.actions.view"), asset_path(asset), class: "text-indigo-600 hover:text-indigo-800 font-medium" %>
                  <%= link_to t("assets.actions.edit"), edit_asset_path(asset), class: "text-slate-500 hover:text-slate-700 font-medium" %>
                  <%= link_to asset_path(asset, format: :pdf, logo: 1), title: t("assets.actions.download_pdf_logo1"), class: "text-emerald-500 hover:text-emerald-700 transition" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 16v-8m0 8l-3-3m3 3l3-3M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1" />
                    </svg>
                  <% end %>
                  <%= link_to asset_path(asset, format: :pdf, logo: 2), title: t("assets.actions.download_pdf_logo2"), class: "text-orange-500 hover:text-orange-700 transition" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 16v-8m0 8l-3-3m3 3l3-3M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1" />
                    </svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%# Mobile cards %>
    <div class="sm:hidden space-y-3">
      <% @assets.each do |asset| %>
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4">
          <%= link_to asset_path(asset), class: "block hover:opacity-80 transition" do %>
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="font-semibold text-slate-900"><%= asset.receiver_name %></p>
                <p class="text-sm text-slate-500 mt-0.5"><%= asset.receiver_branch_department %></p>
              </div>
              <p class="text-xs text-slate-400 shrink-0"><%= asset.handover_date&.strftime("%d %b %Y") %></p>
            </div>
            <div class="mt-3 flex flex-wrap gap-1.5">
              <% if asset.is_consumable? %>
                <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-700"><%= t("assets.badges.consumable") %></span>
              <% end %>
              <% if asset.is_custody? %>
                <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-indigo-100 text-indigo-700"><%= t("assets.badges.custody") %></span>
              <% end %>
            </div>
          <% end %>
          <div class="mt-3 pt-3 border-t border-slate-100 flex items-center gap-4">
            <%= link_to t("assets.actions.edit"), edit_asset_path(asset), class: "text-sm text-slate-500 hover:text-slate-700 font-medium" %>
            <%= link_to asset_path(asset, format: :pdf, logo: 1), title: t("assets.actions.download_pdf_logo1"), class: "text-emerald-500 hover:text-emerald-700 transition" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 16v-8m0 8l-3-3m3 3l3-3M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1" />
              </svg>
            <% end %>
            <%= link_to asset_path(asset, format: :pdf, logo: 2), title: t("assets.actions.download_pdf_logo2"), class: "text-orange-500 hover:text-orange-700 transition" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 16v-8m0 8l-3-3m3 3l3-3M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1" />
              </svg>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

  <% else %>

    <%# Empty state %>
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm py-16 text-center">
      <div class="w-14 h-14 bg-slate-100 rounded-xl flex items-center justify-center mx-auto mb-4">
        <svg class="w-7 h-7 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0v10l-8 4m0-14L4 17m8 4V11" />
        </svg>
      </div>
      <p class="text-slate-900 font-semibold"><%= t("assets.index.empty_title") %></p>
      <p class="text-slate-500 text-sm mt-1"><%= t("assets.index.empty_description") %></p>
      <%= link_to t("assets.index.new_button"), new_asset_path, class: "mt-5 inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold shadow-sm transition" %>
    </div>

  <% end %>

</div>
