<div>

  <%# Page header %>
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-900"><%= t("assets.index.title") %></h1>
      <p class="mt-1 text-sm text-slate-500"><%= t("assets.index.subtitle", count: @total_count) %></p>
    </div>
    <%= link_to t("assets.index.new_button"), new_asset_path, class: "flex items-center gap-2 px-4 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white text-sm font-semibold shadow-sm transition" %>
  </div>

  <%# Flash notice %>
  <% if notice = flash[:notice] %>
    <div class="mb-6 flex items-center gap-3 rounded-lg bg-green-50 border border-green-200 px-4 py-3">
      <svg class="w-5 h-5 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
      </svg>
      <p class="text-sm font-medium text-green-700"><%= notice %></p>
    </div>
  <% end %>

  <%# Search & Filters %>
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-3 sm:p-4 mb-6">
    <%= form_with url: assets_path, method: :get, data: { controller: "filter-form", turbo_frame: "results", turbo_action: "advance" },
          class: "flex flex-col lg:flex-row lg:items-center gap-3" do %>

      <%# Search %>
      <div class="relative flex-1">
        <svg class="absolute start-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input type="search" name="search" value="<%= params[:search] %>"
               placeholder="<%= t('assets.filters.search_placeholder') %>"
               data-action="input->filter-form#search"
               autocomplete="off"
               class="w-full ps-10 pe-4 py-2.5 rounded-lg border border-slate-200 bg-white text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition">
      </div>

      <%# Date range %>
      <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3">
        <div class="flex items-center gap-2">
          <label class="text-xs font-semibold text-slate-500 uppercase tracking-wide w-10 shrink-0" for="date_from"><%= t("assets.filters.from") %></label>
          <input type="date" name="date_from" id="date_from" value="<%= params[:date_from] %>"
                 data-action="change->filter-form#filter"
                 class="flex-1 sm:flex-none sm:w-40 px-3 py-2.5 rounded-lg border border-slate-200 bg-white text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition">
        </div>
        <div class="flex items-center gap-2">
          <label class="text-xs font-semibold text-slate-500 uppercase tracking-wide w-10 shrink-0" for="date_to"><%= t("assets.filters.to") %></label>
          <input type="date" name="date_to" id="date_to" value="<%= params[:date_to] %>"
                 data-action="change->filter-form#filter"
                 class="flex-1 sm:flex-none sm:w-40 px-3 py-2.5 rounded-lg border border-slate-200 bg-white text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition">
        </div>

        <% if @filters_active %>
          <button type="button" data-action="filter-form#clear"
                  class="flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-lg text-sm text-slate-600 hover:text-slate-900 hover:bg-slate-100 font-medium transition cursor-pointer whitespace-nowrap">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            <%= t("assets.filters.clear") %>
          </button>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= turbo_frame_tag "results" do %>

  <% if @assets.any? %>

    <%# Desktop table %>
    <div class="hidden sm:block bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200">
            <th class="text-start px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide"><%= t("assets.table.date") %></th>
            <th class="text-start px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide"><%= t("assets.table.receiver") %></th>
            <th class="text-start px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide"><%= t("assets.table.employee_number") %></th>
            <th class="text-start px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide"><%= t("assets.table.branch_dept") %></th>
            <th class="text-start px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide"><%= t("assets.table.type") %></th>
            <th class="px-5 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @assets.each do |asset| %>
            <tr class="hover:bg-slate-50 transition group">
              <td class="px-5 py-4 text-slate-900 font-medium whitespace-nowrap">
                <%= asset.handover_date&.strftime("%d %b %Y") || "—" %>
              </td>
              <td class="px-5 py-4 text-slate-800"><%= asset.receiver_name %></td>
              <td class="px-5 py-4 text-slate-600"><%= asset.receiver_employee_number %></td>
              <td class="px-5 py-4 text-slate-600"><%= asset.receiver_branch_department %></td>
              <td class="px-5 py-4">
                <div class="flex flex-wrap gap-1.5">
                  <% if asset.is_consumable? %>
                    <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-700"><%= t("assets.badges.consumable") %></span>
                  <% end %>
                  <% if asset.is_custody? %>
                    <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-indigo-100 text-indigo-700"><%= t("assets.badges.custody") %></span>
                  <% end %>
                  <% unless asset.is_consumable? || asset.is_custody? %>
                    <span class="text-slate-400">—</span>
                  <% end %>
                </div>
              </td>
              <td class="px-5 py-4 text-end whitespace-nowrap">
                <div class="flex items-center justify-end gap-3">
                  <%= link_to t("assets.actions.view"), asset_path(asset), class: "text-indigo-600 hover:text-indigo-800 font-medium" %>
                  <%= link_to t("assets.actions.edit"), edit_asset_path(asset), class: "text-slate-500 hover:text-slate-700 font-medium" %>
                  <%= link_to asset_path(asset, format: :pdf, logo: 1), title: t("assets.actions.download_pdf_logo1"), class: "text-emerald-500 hover:text-emerald-700 transition" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 16v-8m0 8l-3-3m3 3l3-3M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1" />
                    </svg>
                  <% end %>
                  <%= link_to asset_path(asset, format: :pdf, logo: 2), title: t("assets.actions.download_pdf_logo2"), class: "text-orange-500 hover:text-orange-700 transition" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 16v-8m0 8l-3-3m3 3l3-3M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1" />
                    </svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%# Mobile cards %>
    <div class="sm:hidden space-y-3">
      <% @assets.each do |asset| %>
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4">
          <%= link_to asset_path(asset), class: "block hover:opacity-80 transition" do %>
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="font-semibold text-slate-900"><%= asset.receiver_name %></p>
                <p class="text-sm text-slate-500 mt-0.5"><%= asset.receiver_branch_department %></p>
              </div>
              <p class="text-xs text-slate-400 shrink-0"><%= asset.handover_date&.strftime("%d %b %Y") %></p>
            </div>
            <div class="mt-3 flex flex-wrap gap-1.5">
              <% if asset.is_consumable? %>
                <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-700"><%= t("assets.badges.consumable") %></span>
              <% end %>
              <% if asset.is_custody? %>
                <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-indigo-100 text-indigo-700"><%= t("assets.badges.custody") %></span>
              <% end %>
            </div>
          <% end %>
          <div class="mt-3 pt-3 border-t border-slate-100 flex items-center gap-4">
            <%= link_to t("assets.actions.edit"), edit_asset_path(asset), class: "text-sm text-slate-500 hover:text-slate-700 font-medium" %>
            <%= link_to asset_path(asset, format: :pdf, logo: 1), title: t("assets.actions.download_pdf_logo1"), class: "text-emerald-500 hover:text-emerald-700 transition" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 16v-8m0 8l-3-3m3 3l3-3M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1" />
              </svg>
            <% end %>
            <%= link_to asset_path(asset, format: :pdf, logo: 2), title: t("assets.actions.download_pdf_logo2"), class: "text-orange-500 hover:text-orange-700 transition" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 16v-8m0 8l-3-3m3 3l3-3M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1" />
              </svg>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Pagination %>
    <% if @pagy.pages > 1 %>
      <nav class="mt-6 flex flex-col sm:flex-row items-center justify-between gap-4" aria-label="Pagination">
        <p class="text-sm text-slate-500">
          <%= t("assets.pagination.showing",
                from: @pagy.from,
                to: @pagy.to,
                count: @pagy.count) %>
        </p>
        <div class="flex items-center gap-1">
          <% if @pagy.prev %>
            <%= link_to url_for(request.query_parameters.merge(page: @pagy.prev)),
                  class: "px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-100 transition",
                  aria: { label: t("assets.pagination.previous") } do %>
              <svg class="w-4 h-4 rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
              </svg>
            <% end %>
          <% end %>

          <% pagy_series = @pagy.series %>
          <% pagy_series.each do |item| %>
            <% if item.is_a?(Integer) %>
              <%= link_to item, url_for(request.query_parameters.merge(page: item)),
                    class: "px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-100 transition" %>
            <% elsif item.is_a?(String) %>
              <span class="px-3 py-2 rounded-lg text-sm font-semibold bg-indigo-600 text-white"><%= item %></span>
            <% elsif item == :gap %>
              <span class="px-2 py-2 text-sm text-slate-400">&hellip;</span>
            <% end %>
          <% end %>

          <% if @pagy.next %>
            <%= link_to url_for(request.query_parameters.merge(page: @pagy.next)),
                  class: "px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-100 transition",
                  aria: { label: t("assets.pagination.next") } do %>
              <svg class="w-4 h-4 rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            <% end %>
          <% end %>
        </div>
      </nav>
    <% end %>

  <% elsif @filters_active %>

    <%# No results (filters active) %>
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm py-16 text-center">
      <div class="w-14 h-14 bg-slate-100 rounded-xl flex items-center justify-center mx-auto mb-4">
        <svg class="w-7 h-7 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
      <p class="text-slate-900 font-semibold"><%= t("assets.index.no_results_title") %></p>
      <p class="text-slate-500 text-sm mt-1"><%= t("assets.index.no_results_description") %></p>
    </div>

  <% else %>

    <%# Empty state %>
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm py-16 text-center">
      <div class="w-14 h-14 bg-slate-100 rounded-xl flex items-center justify-center mx-auto mb-4">
        <svg class="w-7 h-7 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0v10l-8 4m0-14L4 17m8 4V11" />
        </svg>
      </div>
      <p class="text-slate-900 font-semibold"><%= t("assets.index.empty_title") %></p>
      <p class="text-slate-500 text-sm mt-1"><%= t("assets.index.empty_description") %></p>
      <%= link_to t("assets.index.new_button"), new_asset_path, class: "mt-5 inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold shadow-sm transition" %>
    </div>

  <% end %>

  <% end %>

</div>
