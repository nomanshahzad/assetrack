<div class="max-w-4xl mx-auto">

  <%# Page header %>
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-6">
    <div>
      <div class="flex items-center gap-2 text-sm text-slate-500 mb-1">
        <%= link_to t("assets.index.title"), assets_path, class: "hover:text-slate-700 transition" %>
        <span>/</span>
        <span class="text-slate-900 font-medium">#<%= @asset.id %></span>
      </div>
      <h1 class="text-2xl font-bold text-slate-900"><%= t("assets.show.title") %></h1>
    </div>
    <div class="flex flex-col sm:flex-row sm:items-center gap-2">
      <%= link_to asset_path(@asset, format: :pdf, logo: 1),
            class: "flex items-center justify-center sm:justify-start gap-1.5 px-4 py-2 rounded-lg border border-slate-300 bg-white text-sm font-medium text-slate-700 hover:bg-slate-50 transition shadow-sm w-full sm:w-auto" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <%= t("assets.actions.download_pdf_logo1") %>
      <% end %>
      <%= link_to asset_path(@asset, format: :pdf, logo: 2),
            class: "flex items-center justify-center sm:justify-start gap-1.5 px-4 py-2 rounded-lg border border-slate-300 bg-white text-sm font-medium text-slate-700 hover:bg-slate-50 transition shadow-sm w-full sm:w-auto" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <%= t("assets.actions.download_pdf_logo2") %>
      <% end %>
      <div class="flex items-center gap-2">
        <%= link_to t("assets.actions.edit"), edit_asset_path(@asset), class: "flex items-center gap-1.5 px-4 py-2 rounded-lg border border-slate-300 bg-white text-sm font-medium text-slate-700 hover:bg-slate-50 transition shadow-sm" %>
        <%= button_to t("assets.actions.delete"), asset_path(@asset), method: :delete,
              data: { turbo_confirm: "Are you sure?" },
              class: "flex items-center gap-1.5 px-4 py-2 rounded-lg border border-red-200 bg-white text-sm font-medium text-red-600 hover:bg-red-50 transition shadow-sm cursor-pointer" %>
      </div>
    </div>
  </div>

  <%# Flash notice %>
  <% if notice = flash[:notice] %>
    <div class="mb-6 flex items-center gap-3 rounded-lg bg-green-50 border border-green-200 px-4 py-3">
      <svg class="w-5 h-5 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
      </svg>
      <p class="text-sm font-medium text-green-700"><%= notice %></p>
    </div>
  <% end %>

  <div class="space-y-6">

    <%# Date %>
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="bg-slate-50 border-b border-slate-200 px-6 py-3">
        <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wide"><%= t("assets.sections.date") %></h3>
      </div>
      <div class="px-6 py-5">
        <p class="text-sm text-slate-500"><%= t("assets.fields.handover_date") %></p>
        <p class="mt-1 text-slate-900 font-medium"><%= @asset.handover_date&.strftime("%B %d, %Y") || "—" %></p>
      </div>
    </div>

    <%# Receiver Information %>
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="bg-slate-50 border-b border-slate-200 px-6 py-3">
        <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wide"><%= t("assets.sections.receiver_information") %></h3>
      </div>
      <div class="px-6 py-5 grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div>
          <p class="text-sm text-slate-500"><%= t("assets.fields.receiver_name") %></p>
          <p class="mt-1 text-slate-900 font-medium"><%= @asset.receiver_name.presence || "—" %></p>
        </div>
        <div>
          <p class="text-sm text-slate-500"><%= t("assets.fields.receiver_employee_number") %></p>
          <p class="mt-1 text-slate-900 font-medium"><%= @asset.receiver_employee_number.presence || "—" %></p>
        </div>
        <div>
          <p class="text-sm text-slate-500"><%= t("assets.fields.receiver_branch_department") %></p>
          <p class="mt-1 text-slate-900 font-medium"><%= @asset.receiver_branch_department.presence || "—" %></p>
        </div>
      </div>
    </div>

    <%# Item Type %>
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="bg-slate-50 border-b border-slate-200 px-6 py-3">
        <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wide"><%= t("assets.sections.item_type") %></h3>
      </div>
      <div class="px-6 py-5 flex flex-wrap gap-3">
        <% if @asset.is_consumable? %>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-700">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
            <%= t("assets.badges.consumable") %>
          </span>
        <% end %>
        <% if @asset.is_custody? %>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-100 text-indigo-700">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
            <%= t("assets.badges.custody") %>
          </span>
        <% end %>
        <% unless @asset.is_consumable? || @asset.is_custody? %>
          <p class="text-sm text-slate-400"><%= t("assets.show.no_type") %></p>
        <% end %>
      </div>
    </div>

    <%# Item Details %>
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="bg-slate-50 border-b border-slate-200 px-6 py-3">
        <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wide"><%= t("asset_items.section") %></h3>
      </div>
      <% if @asset.asset_items.any? %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wide">
                <th class="px-4 py-2.5 text-center w-10"><%= t("asset_items.no") %></th>
                <th class="px-4 py-2.5 text-start"><%= t("asset_items.item_details") %></th>
                <th class="px-4 py-2.5 text-center"><%= t("asset_items.is_consumable") %></th>
                <th class="px-4 py-2.5 text-center"><%= t("asset_items.is_custody") %></th>
                <th class="px-4 py-2.5 text-center"><%= t("asset_items.quantity") %></th>
                <th class="px-4 py-2.5 text-center"><%= t("asset_items.is_new") %></th>
                <th class="px-4 py-2.5 text-center"><%= t("asset_items.is_used") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @asset.asset_items.each_with_index do |item, i| %>
                <tr class="hover:bg-slate-50">
                  <td class="px-4 py-3 text-center text-slate-500"><%= i + 1 %></td>
                  <td class="px-4 py-3 text-slate-900"><%= item.item_details.presence || "—" %></td>
                  <td class="px-4 py-3 text-center">
                    <% if item.is_consumable? %>
                      <span class="inline-block w-4 h-4 rounded-full bg-indigo-500"></span>
                    <% else %>
                      <span class="text-slate-300">—</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-3 text-center">
                    <% if item.is_custody? %>
                      <span class="inline-block w-4 h-4 rounded-full bg-indigo-500"></span>
                    <% else %>
                      <span class="text-slate-300">—</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-3 text-center text-slate-900"><%= item.quantity.presence || "—" %></td>
                  <td class="px-4 py-3 text-center">
                    <% if item.is_new? %>
                      <span class="inline-block w-4 h-4 rounded-full bg-green-500"></span>
                    <% else %>
                      <span class="text-slate-300">—</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-3 text-center">
                    <% if item.is_used? %>
                      <span class="inline-block w-4 h-4 rounded-full bg-amber-500"></span>
                    <% else %>
                      <span class="text-slate-300">—</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="px-6 py-5">
          <p class="text-sm text-slate-400"><%= t("asset_items.empty") %></p>
        </div>
      <% end %>
    </div>

    <%# Notes %>
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="bg-slate-50 border-b border-slate-200 px-6 py-3">
        <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wide"><%= t("assets.sections.notes") %></h3>
      </div>
      <div class="px-6 py-5">
        <% if @asset.notes.present? %>
          <p class="text-slate-900 text-sm leading-relaxed whitespace-pre-wrap"><%= @asset.notes %></p>
        <% else %>
          <p class="text-slate-400 text-sm"><%= t("assets.show.no_notes") %></p>
        <% end %>
      </div>
    </div>

    <%# Delivered By %>
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="bg-slate-50 border-b border-slate-200 px-6 py-3">
        <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wide"><%= t("assets.sections.delivered_by") %></h3>
      </div>
      <div class="px-6 py-5 space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <p class="text-sm text-slate-500"><%= t("assets.fields.delivered_by_name") %></p>
            <p class="mt-1 text-slate-900 font-medium"><%= @asset.delivered_by_name.presence || "—" %></p>
          </div>
          <div>
            <p class="text-sm text-slate-500"><%= t("assets.fields.delivered_by_date") %></p>
            <p class="mt-1 text-slate-900 font-medium"><%= @asset.delivered_by_date&.strftime("%B %d, %Y") || "—" %></p>
          </div>
        </div>
        <div>
          <p class="text-sm text-slate-500 mb-2"><%= t("assets.fields.signature") %></p>
          <% if @asset.signature_delivered_by.present? %>
            <img src="<%= @asset.signature_delivered_by %>" alt="Signature"
                 class="h-40 rounded-lg border border-slate-200 bg-white object-contain">
          <% else %>
            <div class="h-40 rounded-lg border border-slate-200 bg-slate-50 flex items-center justify-center">
              <span class="text-sm text-slate-400">—</span>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Received By %>
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="bg-slate-50 border-b border-slate-200 px-6 py-3">
        <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wide"><%= t("assets.sections.received_by") %></h3>
      </div>
      <div class="px-6 py-5 space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <p class="text-sm text-slate-500"><%= t("assets.fields.received_by_name") %></p>
            <p class="mt-1 text-slate-900 font-medium"><%= @asset.received_by_name.presence || "—" %></p>
          </div>
          <div>
            <p class="text-sm text-slate-500"><%= t("assets.fields.received_by_date") %></p>
            <p class="mt-1 text-slate-900 font-medium"><%= @asset.received_by_date&.strftime("%B %d, %Y") || "—" %></p>
          </div>
        </div>
        <div>
          <p class="text-sm text-slate-500 mb-2"><%= t("assets.fields.signature") %></p>
          <% if @asset.signature_received_by.present? %>
            <img src="<%= @asset.signature_received_by %>" alt="Signature"
                 class="h-40 rounded-lg border border-slate-200 bg-white object-contain">
          <% else %>
            <div class="h-40 rounded-lg border border-slate-200 bg-slate-50 flex items-center justify-center">
              <span class="text-sm text-slate-400">—</span>
            </div>
          <% end %>
        </div>
      </div>
    </div>

  </div>
</div>
