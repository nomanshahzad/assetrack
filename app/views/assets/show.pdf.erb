<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  html, body {
    width: 100%;
    margin: 0;
    padding: 0;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 11pt;
    color: #1a1a1a;
    background: white;
  }

  /* Fixed border that always spans the full page */
  .border-frame {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    border: 4px solid #1e7e34;
    pointer-events: none;
    z-index: 0;
  }

  /* ── Content ── */
  .page {
    width: 100%;
    direction: rtl;
    padding: 7mm 9mm 6mm;
    position: relative;
    z-index: 1;
  }

  /* ── Header ── */
  .header {
    display: table;
    width: 100%;
    margin-bottom: 5mm;
  }
  .header-ar, .header-logo, .header-en {
    display: table-cell;
    vertical-align: middle;
  }
  .header-ar   { width: 38%; text-align: center; vertical-align: middle; }
  .header-logo { width: 24%; text-align: center; }
  .header-en   { width: 38%; text-align: center; vertical-align: middle;
                 font-size: 12pt; font-weight: bold; color: #1e7e34; }

  .ar-company-name { font-size: 14pt; font-weight: bold; }

  .corner {
    display: inline-block;
    width: 15px;
    margin-right: 5px;
    vertical-align: top;
  }
  .cs { display: block; height: 10px; width: 100%; }
  .cs-g { background: #1e7e34; }
  .cs-y { background: #e6a817; }
  .cs-r { background: #c0392b; }

  .sep { border: none; border-top: 1.5px solid #888; margin: 3mm 0; }

  /* ── Date ── */
  .date-row {
    text-align: right;
    font-size: 10pt;
    margin: 10mm 0 12mm;
    letter-spacing: 0.3px;
  }
  .dots { border-bottom: 1px solid #555; display: inline-block; min-width: 35mm; }

  /* ── Title ── */
  .title-wrap { text-align: center; margin: 0 0 13mm; }
  .title-box {
    display: inline-block;
    border: 1.5px solid #333;
    font-size: 12pt;
    font-weight: bold;
    padding: 10px 18px;
    white-space: nowrap;
  }

  /* ── Section label ── */
  .slabel { font-size: 10pt; font-weight: bold; margin-bottom: 7mm; }

  /* ── Field rows ── */
  .frow { font-size: 10pt; margin-bottom: 7mm; }
  .fval {
    display: inline-block;
    border-bottom: 1px solid #666;
    min-width: 110mm;
    padding: 1px 4px;
    vertical-align: bottom;
  }

  /* ── Item type ── */
  .item-type {
    font-size: 10pt;
    margin: 2mm 0 4mm;
    text-align: center;
  }
  .item-val {
    display: inline-block;
    border-bottom: 1px solid #666;
    min-width: 30mm;
    vertical-align: bottom;
    padding: 0 3px;
  }

  /* ── Items table ── */
  .itable { width: 100%; border-collapse: collapse; margin-bottom: 4mm; }
  .itable th, .itable td {
    border: 1px solid #555;
    text-align: center;
    vertical-align: middle;
    padding: 4px 3px;
  }
  .itable th { background: #f0f0f0; font-weight: bold; font-size: 10pt; padding: 9px 3px; }
  .itable td { font-size: 10pt; height: 9mm; }
  .col-no   { width: 8mm; }
  .col-det  { text-align: right !important; padding-right: 5px !important; }
  .col-chk  { width: 16mm; }
  .col-qty  { width: 13mm; }

  /* ── Notes ── */
  .notes-label { font-size: 10pt; font-weight: bold; margin-top: 6mm; margin-bottom: 3mm; }
  .notes-box {
    border: 1px solid #555;
    height: 22mm;
    padding: 3px 6px;
    font-size: 10pt;
    text-align: right;
    white-space: pre-wrap;
  }

  /* ── Declaration ── */
  .declaration {
    font-size: 9.5pt;
    text-align: right;
    margin: 16mm 0;
    line-height: 1.7;
  }

  /* ── Signatures ── */
  .sig-wrap { display: table; width: 100%; margin-top: 3mm; }
  .sig-col  { display: table-cell; width: 50%; vertical-align: top; padding: 0 4mm; }
  .sig-title { font-size: 11pt; font-weight: bold; text-align: center; margin-bottom: 5mm; }
  .sig-field { font-size: 10pt; margin-bottom: 8mm; }
  .sig-line {
    display: inline-block;
    border-bottom: 1px solid #666;
    min-width: 65mm;
    padding: 0 3px;
    vertical-align: bottom;
  }
  .sig-img-wrap {
    display: inline-block;
    border-bottom: 1px solid #666;
    vertical-align: bottom;
    min-width: 65mm;
  }

  /* ── Footer ── */
  .footer {
    position: fixed;
    bottom: 6mm;
    left: 0;
    right: 0;
    font-size: 8pt;
    text-align: center;
    color: #444;
  }
</style>

<div class="border-frame"></div>
<div class="page">

  <%# ── Header ── %>
  <div class="header">
    <div class="header-ar">
      <div class="ar-company-name">مجموعة الهنوف للمقاولات</div>
    </div>
    <div class="header-logo">
      <% logo_b64 = Base64.strict_encode64(File.read(Rails.root.join('app','assets','images','logo.png'))) %>
      <img src="data:image/png;base64,<%= logo_b64 %>" style="height:150px; width:auto;">
    </div>
    <div class="header-en">AL HANOUF CONTRACTING GROUP</div>
  </div>

  <hr class="sep">

  <%# ── Date ── %>
  <div class="date-row">
    التاريخ :&nbsp;&nbsp;<span class="dots">&nbsp;<%= @asset.handover_date&.strftime("%Y/%m/%d") %>&nbsp;</span>
  </div>

  <%# ── Title ── %>
  <div class="title-wrap">
    <div class="title-box">نموذج استلام وتسليم قسم تكنولوجيا المعلومات</div>
  </div>

  <%# ── Receiver Info ── %>
  <div class="slabel">بيانات المستلم</div>

  <div class="frow">
    الاسم :&nbsp;
    <span class="fval">&nbsp;<%= @asset.receiver_name %>&nbsp;</span>
  </div>
  <div class="frow">
    رقم الوظيفة :&nbsp;
    <span class="fval">&nbsp;<%= @asset.receiver_employee_number %>&nbsp;</span>
  </div>
  <div class="frow">
    الموقع/ قسم :&nbsp;
    <span class="fval">&nbsp;<%= @asset.receiver_branch_department %>&nbsp;</span>
  </div>

  <%# ── Item Type ── %>
  <div class="item-type">
    استهلاكية :&nbsp;<span class="item-val"><%= raw(@asset.is_consumable? ? "&nbsp;&#10003;&nbsp;" : "&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;") %></span>
    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
    عهدة :&nbsp;<span class="item-val"><%= raw(@asset.is_custody? ? "&nbsp;&#10003;&nbsp;" : "&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;") %></span>
  </div>

  <%# ── Items Table ── %>
  <table class="itable">
    <thead>
      <tr>
        <th class="col-no">م</th>
        <th class="col-det">بيانات الأصناف</th>
        <th class="col-chk">استهلاكية</th>
        <th class="col-chk">عهدة</th>
        <th class="col-qty">الكمية</th>
        <th class="col-chk">جديد</th>
        <th class="col-chk">مستعمل</th>
      </tr>
    </thead>
    <tbody>
      <% items = @asset.asset_items.to_a %>
      <% [*items, *Array.new([5 - items.size, 0].max)].each_with_index do |item, i| %>
        <tr>
          <td><%= i + 1 %></td>
          <td class="col-det">&nbsp;<%= item&.item_details %></td>
          <td><%= raw(item&.is_consumable? ? "&#10003;" : "") %></td>
          <td><%= raw(item&.is_custody?    ? "&#10003;" : "") %></td>
          <td><%= item&.quantity %></td>
          <td><%= raw(item&.is_new?  ? "&#10003;" : "") %></td>
          <td><%= raw(item&.is_used? ? "&#10003;" : "") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%# ── Notes ── %>
  <div class="notes-label">ملاحظات :</div>
  <div class="notes-box"><%= @asset.notes %></div>

  <%# ── Declaration ── %>
  <p class="declaration">
    أقر أنا الموقع أدناه بأني استلمت الأصناف الموضحة أعلاه، والعهد بالمحافظة عليها وإعادتها إلى المؤسسة عند الطلب.
  </p>

  <%# ── Signatures ── %>
  <div class="sig-wrap">
    <div class="sig-col">
      <div class="sig-title">التوقيع بالاستلام</div>
      <div class="sig-field">
        الاسم :&nbsp;
        <span class="sig-line">&nbsp;<%= @asset.received_by_name %>&nbsp;</span>
      </div>
      <div class="sig-field">
        التوقيع :&nbsp;
        <% if @asset.signature_received_by.present? %>
          <span class="sig-img-wrap">
            <img src="<%= @asset.signature_received_by %>" style="height:28px; max-width:62mm; vertical-align:bottom; display:block;">
          </span>
        <% else %>
          <span class="sig-line">&nbsp;</span>
        <% end %>
      </div>
      <div class="sig-field">
        التاريخ :&nbsp;
        <span class="sig-line">&nbsp;<%= @asset.received_by_date&.strftime("%Y/%m/%d") %>&nbsp;</span>
      </div>
    </div>
    <div class="sig-col">
      <div class="sig-title">التوقيع بالتسليم</div>
      <div class="sig-field">
        الاسم :&nbsp;
        <span class="sig-line">&nbsp;<%= @asset.delivered_by_name %>&nbsp;</span>
      </div>
      <div class="sig-field">
        التوقيع :&nbsp;
        <% if @asset.signature_delivered_by.present? %>
          <span class="sig-img-wrap">
            <img src="<%= @asset.signature_delivered_by %>" style="height:28px; max-width:62mm; vertical-align:bottom; display:block;">
          </span>
        <% else %>
          <span class="sig-line">&nbsp;</span>
        <% end %>
      </div>
      <div class="sig-field">
        التاريخ :&nbsp;
        <span class="sig-line">&nbsp;<%= @asset.delivered_by_date&.strftime("%Y/%m/%d") %>&nbsp;</span>
      </div>
    </div>
  </div>

  <%# ── Footer ── %>
  <div class="footer">
    المملكة العربية السعودية &nbsp;-&nbsp; ص. ب ١٧٣٥ &nbsp;-&nbsp; الرياض ١١٤١٢ &nbsp;&nbsp;|&nbsp;&nbsp; تلفون: ٠١١٦٩٦٥٢١١ &nbsp;&nbsp;|&nbsp;&nbsp; فاكس: ٠١١٦٩٣٢٥٤٨
  </div>

</div>
