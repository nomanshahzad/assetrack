<tr class="block border border-slate-200 rounded-xl mb-3 overflow-hidden
            sm:table-row sm:border-0 sm:border-b sm:border-slate-100 sm:rounded-none sm:mb-0 sm:overflow-visible sm:hover:bg-slate-50 sm:transition">

  <%# Row number ── header bar on mobile, plain cell on desktop %>
  <td class="block px-4 py-2.5 bg-slate-100 border-b border-slate-200 text-sm font-semibold text-slate-600 text-center sm:table-cell sm:w-10 sm:px-3 sm:py-2 sm:text-center sm:text-sm sm:bg-transparent sm:border-0 sm:font-normal sm:text-slate-500">
    <span class="sm:hidden"><%= t("asset_items.no") %> </span><span data-row-number></span>
  </td>

  <%# Item Details ── full-width block on mobile %>
  <td class="block px-4 py-3 sm:table-cell sm:px-3 sm:py-2 sm:min-w-48">
    <label class="block text-xs font-medium text-slate-500 mb-1 sm:hidden"><%= t("asset_items.item_details") %></label>
    <%= f.text_field :item_details,
          class: "block w-full rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" %>
  </td>

  <%# Consumable %>
  <td class="block px-4 py-2 sm:table-cell sm:px-3 sm:py-2 sm:text-center">
    <label class="flex items-center gap-2 sm:justify-center cursor-pointer">
      <%= f.check_box :is_consumable, class: "w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" %>
      <span class="text-sm text-slate-700 sm:hidden"><%= t("asset_items.is_consumable") %></span>
    </label>
  </td>

  <%# Custody %>
  <td class="block px-4 py-2 sm:table-cell sm:px-3 sm:py-2 sm:text-center">
    <label class="flex items-center gap-2 sm:justify-center cursor-pointer">
      <%= f.check_box :is_custody, class: "w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" %>
      <span class="text-sm text-slate-700 sm:hidden"><%= t("asset_items.is_custody") %></span>
    </label>
  </td>

  <%# Quantity ── block on mobile with label %>
  <td class="block px-4 py-3 sm:table-cell sm:px-3 sm:py-2 sm:w-24">
    <label class="block text-xs font-medium text-slate-500 mb-1 sm:hidden"><%= t("asset_items.quantity") %></label>
    <%= f.number_field :quantity, min: 0,
          class: "block w-28 sm:w-full rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-900 text-center focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" %>
  </td>

  <%# New %>
  <td class="block px-4 py-2 sm:table-cell sm:px-3 sm:py-2 sm:text-center">
    <label class="flex items-center gap-2 sm:justify-center cursor-pointer">
      <%= f.check_box :is_new, class: "w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" %>
      <span class="text-sm text-slate-700 sm:hidden"><%= t("asset_items.is_new") %></span>
    </label>
  </td>

  <%# Used %>
  <td class="block px-4 py-2 sm:table-cell sm:px-3 sm:py-2 sm:text-center">
    <label class="flex items-center gap-2 sm:justify-center cursor-pointer">
      <%= f.check_box :is_used, class: "w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" %>
      <span class="text-sm text-slate-700 sm:hidden"><%= t("asset_items.is_used") %></span>
    </label>
  </td>

  <%= f.hidden_field :_destroy, value: "0" %>

  <%# Remove button %>
  <td class="block px-4 py-3 bg-slate-50 border-t border-slate-100 text-end sm:table-cell sm:w-10 sm:px-3 sm:py-2 sm:bg-transparent sm:border-0 sm:text-center">
    <button type="button"
            data-action="click->nested-form#removeRow"
            class="text-red-400 hover:text-red-600 transition cursor-pointer"
            title="<%= t('asset_items.remove') %>">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
      </svg>
    </button>
  </td>

</tr>
