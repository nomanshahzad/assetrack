<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= I18n.locale == :ar ? 'rtl' : 'ltr' %>">
  <head>
    <title><%= content_for(:title) || "Assetrack" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Assetrack">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-gray-50">

    <%# ── Top navigation bar ────────────────────────────────────────── %>
    <nav class="bg-white border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">

          <%# Logo %>
          <%= link_to root_path, class: "flex items-center gap-2.5" do %>
            <div class="w-8 h-8 bg-indigo-500 rounded-lg flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0v10l-8 4m0-14L4 17m8 4V11" />
              </svg>
            </div>
            <span class="text-slate-900 font-bold text-lg tracking-tight">Assetrack</span>
          <% end %>

          <%# Right side: language switcher + sign out %>
          <div class="flex items-center gap-4">

            <%# Language switcher %>
            <% other_locale = I18n.locale == :ar ? :en : :ar %>
            <%= link_to request.path + "?locale=#{other_locale}",
                  class: "flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-slate-900 transition" do %>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 21l5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 016-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 01-3.827-5.802" />
              </svg>
              <%= other_locale == :ar ? "العربية" : "English" %>
            <% end %>

            <%# Sign out %>
            <%= button_to "Sign out", session_path, method: :delete,
                  class: "text-sm text-slate-500 hover:text-slate-900 font-medium transition cursor-pointer" %>

          </div>
        </div>
      </div>
    </nav>

    <%# ── Page content ───────────────────────────────────────────────── %>
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>

  </body>
</html>
